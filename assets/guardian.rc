1 ICON "assets/guardian.ico"

// The version numbers come from Cargo.toml, passed in as macros by build.rs.
// VS_VERSION_INFO has to be defined as the number 1: undefined, the resource
// compiler treats it as a string name and gives the block a name-derived id,
// which Windows' version queries (they look up RT_VERSION/1) then miss.
#define VS_VERSION_INFO 1

// Symbolic constants (VOS__WINDOWS32 and friends) are spelled out as literals
// so this compiles under both rc.exe and windres without extra headers.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_COMMAS
 PRODUCTVERSION VERSION_COMMAS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BaoCode"
            VALUE "FileDescription", "Guardian"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "guardian"
            VALUE "LegalCopyright", "Copyright (C) 2026 BaoCode"
            VALUE "OriginalFilename", "guardian.exe"
            VALUE "ProductName", "Guardian"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
